{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "titlebar",
      "type": "block",
      "content": {
        "mod": "vsc-titlebar"
      },
      "size": {
        "px": 45
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "activity",
          "type": "block",
          "content": {
            "mod": "vsc-activity"
          },
          "size": {
            "px": 48
          }
        },
        {
          "id": "side",
          "type": "column",
          "children": [
            {
              "id": "side-body",
              "type": "stack",
              "children": [
                {
                  "id": "explorer",
                  "type": "block",
                  "content": {
                    "mod": "vsc-explorer"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "vsc-changes"
                  }
                },
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "spaces"
                  }
                }
              ],
              "active": "explorer",
              "size": {
                "weight": 3
              }
            },
            {
              "id": "agents-list",
              "type": "block",
              "content": {
                "mod": "vsc-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 120,
              "hidden": true
            }
          ],
          "size": {
            "px": 378
          },
          "min": 170,
          "max": 520,
          "background": "chrome",
          "border": {
            "width": 0,
            "color": "border"
          },
          "divider": {
            "width": 1,
            "color": "border"
          },
          "resizable": true
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "panelbar",
              "type": "block",
              "content": {
                "mod": "vsc-panelbar"
              },
              "size": {
                "px": 36
              }
            },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "vsc-pane"
                    },
                    "reveal": "always",
                    "height": 28,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 0,
                  "gap": 0
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "background": "chrome",
  "theme": "dracula",
  "font": "JetBrainsMono Nerd Font",
  "font_size": 13,
  "terminal_padding": [
    6,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    14,
    11
  ]
}
